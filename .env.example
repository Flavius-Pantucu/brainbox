# BrainBox — environment
#
# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value in here.
#
# Six values, and you set all of them. Nothing here is injected for you.


# --------------------------------------------------------------------- app ---
# Absolute URL of this deployment. Used to build shareable room links, which
# have to be absolute to be worth sharing, and read in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ---------------------------------------------------------------- database ---
# Neon Postgres, pooled (-pooler in the host). Every request the app serves
# goes through this one. Serverless opens a lot of short connections, and the
# pooler is what stops Neon running out of them. Keep ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/brainbox?sslmode=require"

# Optional, and only for migrations. The pooler runs in transaction mode and
# cannot hold the session a schema change needs, so `drizzle-kit migrate` wants
# the direct URL — the same string without `-pooler`. It is never read at
# runtime, so Vercel does not need it: set it locally and leave it unset there.
# If it is missing, migrations fall back to DATABASE_URL and may fail on DDL.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/brainbox?sslmode=require"


# -------------------------------------------------------------------- auth ---
# Better Auth. Email and password — no OAuth provider, so there is nothing to
# register with GitHub or Google and no client id or secret to carry.
#
# BETTER_AUTH_SECRET signs and encrypts sessions. Generate one per environment;
# local and production must NOT share it. Changing it logs everyone out.
#
#   openssl rand -base64 32
BETTER_AUTH_SECRET="generate-me-do-not-copy-this-value"

# The base URL Better Auth serves its routes from. Unlike some libraries this
# is not inferred — set it explicitly, and set it to the deployed URL in
# production or sign-in callbacks resolve against the wrong host.
BETTER_AUTH_URL="http://localhost:3000"


# ------------------------------------------------------------------- rooms ---
# Upstash Redis, holding online room state.
#
# Rooms currently live in a globalThis Map, which works under one node process
# and cannot work on Vercel: a player joining may land on an instance that has
# never seen the room. Redis is the shared place every instance reads.
#
# The REST pair, not the redis:// URL — the REST client works from serverless
# without holding a socket open.
# Upstash console > your database > REST API.
UPSTASH_REDIS_REST_URL="https://example-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="paste-the-token-from-the-upstash-rest-api-tab"


# ---------------------------------------------------------------------------
# On Vercel
# ---------------------------------------------------------------------------
#
# Add all of these, to Production / Preview / Development:
#
#   NEXT_PUBLIC_APP_URL         https://<your-project>.vercel.app
#   DATABASE_URL                the POOLED Neon URL
#   BETTER_AUTH_SECRET          a DIFFERENT value from your local one
#   BETTER_AUTH_URL             https://<your-project>.vercel.app
#   UPSTASH_REDIS_REST_URL
#   UPSTASH_REDIS_REST_TOKEN
#
# Leave DATABASE_URL_UNPOOLED unset there — migrations are not run from a
# deployment.
#
# BETTER_AUTH_URL is a single fixed host, so preview deployments authenticate
# against the production URL rather than their own. That is fine for previews
# you only look at. If you ever need to sign in on a preview, set it per
# environment to https://$VERCEL_URL instead.
#
# NEXT_PUBLIC_ is a publishing keyword: anything with that prefix is compiled
# into the browser bundle and is readable by anyone. Only NEXT_PUBLIC_APP_URL
# belongs there. If a key is ever given that prefix, treat that key as leaked.
